        function encryptData(text) {
            if (!text) return "";
            return CryptoJS.AES.encrypt(text.toString(), E2E_SECRET).toString();
        }

        function decryptData(ciphertext) {
            if (!ciphertext) return "";
            try {
                const bytes = CryptoJS.AES.decrypt(ciphertext, E2E_SECRET);
                const decryptedStr = bytes.toString(CryptoJS.enc.Utf8);
                return decryptedStr || ciphertext; 
            } catch (e) {
                return ciphertext;
            }
        }

