<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shiv Clinic - Medical Records</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://apis.google.com/js/api.js"></script>
    <script src="https://accounts.google.com/gsi/client"></script>
    <style>
        /* Custom scrollbar for table if it overflows on mobile */
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #111; 
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #DAA520; 
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #FFD700; 
        }
        /* Input autofill styling for dark mode */
        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active{
            -webkit-box-shadow: 0 0 0 30px #1a1a1a inset !important;
            -webkit-text-fill-color: #FFD700 !important;
        }
    </style>
</head>
<body class="bg-black text-[#FFD700] font-sans min-h-screen">

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-4 right-4 z-50 transform transition-all duration-300 translate-y-[-150%] opacity-0 bg-gray-900 border border-[#DAA520] text-[#FFD700] px-4 py-3 rounded shadow-lg max-w-sm">
        <div class="flex items-center">
            <svg id="toastIcon" class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span id="toastMessage">Notification message</span>
        </div>
    </div>

    <!-- Login Container -->
    <div id="loginContainer" class="min-h-screen flex flex-col items-center justify-center p-4">
        <div class="bg-[#111] border border-[#DAA520] rounded-xl p-8 shadow-[0_0_15px_rgba(218,165,32,0.15)] w-full max-w-md text-center">
            <h1 class="text-4xl font-bold tracking-wider uppercase mb-2 drop-shadow-[0_0_10px_rgba(255,215,0,0.5)]">Shiv Clinic</h1>
            <p class="text-[#DAA520] mb-8 text-lg">Staff Portal Login</p>
            
            <form id="loginForm" class="space-y-5 text-left">
                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-300" for="username">Username</label>
                    <input type="text" id="username" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-3 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-300" for="password">Password</label>
                    <input type="password" id="password" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-3 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                </div>
                <button type="submit" class="w-full bg-[#DAA520] hover:bg-[#FFD700] text-black font-bold py-3 px-4 rounded-md transition-all duration-200 transform hover:scale-[1.02] mt-4 shadow-lg shadow-[#DAA520]/20">
                    Sign In
                </button>
            </form>
            <div id="loginError" class="text-red-500 text-sm mt-4 hidden bg-red-900/20 border border-red-900 p-2 rounded">
                Invalid username or password.
            </div>
            <div class="mt-6 text-xs text-gray-500 text-left bg-[#1a1a1a] p-4 rounded-lg border border-gray-800">
                <p class="text-[#DAA520] mb-1 font-semibold uppercase tracking-wider">Demo Credentials:</p>
                <div class="flex justify-between border-b border-gray-800 pb-1 mb-1"><span>Admin:</span> <span>admin / admin123</span></div>
                <div class="flex justify-between border-b border-gray-800 pb-1 mb-1"><span>Consultant:</span> <span>consultant / consultant123</span></div>
                <div class="flex justify-between"><span>Dr. Rutvik:</span> <span>rutvik3129@gmail.com / Rutvik@12345</span></div>
            </div>
        </div>
    </div>

    <!-- Main Container -->
    <div id="appContainer" class="hidden max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-10 border-b border-[#DAA520]/30 pb-6">
            <div class="text-center md:text-left mb-4 md:mb-0">
                <h1 class="text-3xl md:text-4xl font-bold tracking-wider uppercase mb-1 drop-shadow-[0_0_10px_rgba(255,215,0,0.5)]">Shiv Clinic</h1>
                <p class="text-[#DAA520] text-sm">Patient Medical Data Portal</p>
                <div id="authStatus" class="mt-1 text-xs text-gray-400">Initializing secure local storage...</div>
            </div>
            <div class="flex items-center space-x-6">
                <div class="text-right hidden sm:block">
                    <p class="text-xs text-gray-400">Logged in as:</p>
                    <p id="currentUserDisplay" class="text-[#FFD700] font-bold capitalize tracking-wide">Admin</p>
                </div>
                <button id="logoutBtn" class="bg-gray-900 hover:bg-red-900 hover:text-white hover:border-red-700 text-gray-300 px-4 py-2 rounded-md transition-colors border border-gray-700 text-sm flex items-center shadow-md">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                    Logout
                </button>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex space-x-4 mb-8 border-b border-gray-800 pb-2">
            <button id="navDataManagement" class="text-[#DAA520] font-semibold border-b-2 border-[#DAA520] pb-2 px-4 transition-colors">Data Management</button>
            <button id="navDoctorProfile" class="text-gray-400 hover:text-[#FFD700] pb-2 px-4 transition-colors border-b-2 border-transparent">Doctor Profile</button>
        </div>

        <!-- Doctor Profile Section -->
        <div id="doctorProfileSection" class="hidden bg-[#111] border border-[#DAA520] rounded-xl p-8 shadow-[0_0_15px_rgba(218,165,32,0.15)] max-w-3xl mx-auto">
            <h2 class="text-2xl font-semibold mb-6 border-b border-[#DAA520] pb-2">Doctor Profile Settings</h2>
            <form id="profileForm" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-300">Doctor Name</label>
                        <input type="text" id="profName" class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700]">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-300">Specialization</label>
                        <input type="text" id="profSpec" class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700]">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-300">Contact Number</label>
                        <input type="tel" id="profContact" class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700]">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-300">Email Address</label>
                        <input type="email" id="profEmail" class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700]">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium mb-1 text-gray-300">Clinic Address</label>
                        <textarea id="profAddress" rows="2" class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] resize-none"></textarea>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium mb-1 text-gray-300">Professional Bio / Notes</label>
                        <textarea id="profBio" rows="4" class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] resize-none"></textarea>
                    </div>
                </div>
                <button type="submit" id="saveProfileBtn" class="w-full bg-[#DAA520] hover:bg-[#FFD700] text-black font-bold py-3 px-4 rounded-md transition-all duration-200 transform hover:scale-[1.02]">
                    Save Profile Information
                </button>
            </form>
        </div>

        <!-- Data Management Section -->
        <div id="dataManagementSection" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Left Column: Add Patient Form -->
            <div class="lg:col-span-1">
                <div class="bg-[#111] border border-[#DAA520] rounded-xl p-6 shadow-[0_0_15px_rgba(218,165,32,0.15)]">
                    <h2 class="text-2xl font-semibold mb-6 border-b border-[#DAA520] pb-2">New Patient Record</h2>
                    
                    <form id="patientForm" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1" for="patientName">Patient Name</label>
                            <input type="text" id="patientName" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1" for="patientAge">Age</label>
                                <input type="number" id="patientAge" min="0" max="150" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1" for="patientDate">Date</label>
                                <input type="date" id="patientDate" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1" for="patientContact">Contact Number</label>
                                <input type="tel" id="patientContact" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1" for="patientCost">Consultation Cost (₹)</label>
                                <input type="number" id="patientCost" min="0" step="0.01" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1" for="amountPaid">Amount Paid (₹)</label>
                                <input type="number" id="amountPaid" min="0" step="0.01" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1" for="paymentMethod">Method</label>
                                <select id="paymentMethod" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                                    <option value="Cash">Cash</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Card">Card</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1" for="paymentStatus">Status</label>
                                <select id="paymentStatus" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                                    <option value="Fully Paid">Fully Paid</option>
                                    <option value="Partial">Partial</option>
                                    <option value="Pending">Pending</option>
                                </select>
                            </div>
                        </div>
                        <div class="text-right text-sm text-gray-400">
                            Balance Due: <span id="balanceDueDisplay" class="text-[#DAA520] font-bold">₹0.00</span>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1" for="patientDiagnosis">Diagnosis</label>
                            <input type="text" id="patientDiagnosis" list="commonDiagnosis" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors">
                            <datalist id="commonDiagnosis">
                                <option value="Viral Fever"></option>
                                <option value="Hypertension"></option>
                                <option value="Type 2 Diabetes Mellitus"></option>
                                <option value="Upper Respiratory Tract Infection"></option>
                                <option value="Gastroenteritis"></option>
                            </datalist>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1" for="patientMeds">Prescription / Medications</label>
                            <div class="flex flex-wrap gap-2 mb-2">
                                <button type="button" class="quick-med-btn bg-gray-800 text-[#DAA520] text-xs px-2 py-1 rounded border border-gray-700 hover:bg-gray-700 hover:text-[#FFD700] transition-colors" data-med="Paracetamol 500mg (1-1-1)">Paracetamol 500mg</button>
                                <button type="button" class="quick-med-btn bg-gray-800 text-[#DAA520] text-xs px-2 py-1 rounded border border-gray-700 hover:bg-gray-700 hover:text-[#FFD700] transition-colors" data-med="Amoxicillin 500mg (1-0-1)">Amoxicillin 500mg</button>
                                <button type="button" class="quick-med-btn bg-gray-800 text-[#DAA520] text-xs px-2 py-1 rounded border border-gray-700 hover:bg-gray-700 hover:text-[#FFD700] transition-colors" data-med="Pantoprazole 40mg (1-0-0) AC">Pantoprazole 40mg</button>
                            </div>
                            <textarea id="patientMeds" rows="4" required class="w-full bg-[#1a1a1a] border border-gray-700 rounded-md px-3 py-2 text-[#FFD700] focus:outline-none focus:border-[#FFD700] focus:ring-1 focus:ring-[#FFD700] transition-colors resize-none"></textarea>
                        </div>

                        <button type="submit" id="submitBtn" class="w-full bg-[#DAA520] hover:bg-[#FFD700] text-black font-bold py-3 px-4 rounded-md transition-all duration-200 transform hover:scale-[1.02] mt-4">
                            Save Record
                        </button>
                    </form>
                </div>
            </div>

            <!-- Right Column: Dashboard / Table -->
            <div class="lg:col-span-2">
                
                <!-- REVENUE WIDGET -->
                <div id="revenueWidgetWrapper" class="bg-[#111] border border-[#DAA520] rounded-xl p-4 mb-6 shadow-[0_0_15px_rgba(218,165,32,0.15)] flex justify-between items-center transition-all duration-300">
                    <div>
                        <h3 class="text-gray-400 text-sm font-medium uppercase tracking-wider">Total Revenue Collected</h3>
                        <p class="text-3xl font-bold text-[#FFD700]" id="totalRevenueDisplay">₹0.00</p>
                    </div>
                    <div class="p-3 bg-[#1a1a1a] rounded-full border border-gray-700">
                        <svg class="w-8 h-8 text-[#DAA520]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                </div>

                <div class="bg-[#111] border border-[#DAA520] rounded-xl p-6 shadow-[0_0_15px_rgba(218,165,32,0.15)] h-full flex flex-col">
                    <div class="flex justify-between items-center mb-6 border-b border-[#DAA520] pb-2">
                        <h2 class="text-2xl font-semibold">Patient Dashboard</h2>
                        <div class="flex items-center space-x-4">
                            <button id="exportPdfBtn" class="bg-blue-900/50 hover:bg-blue-800 border border-blue-500 text-blue-200 px-3 py-1.5 rounded text-sm transition-colors flex items-center shadow-md">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                Export PDF
                            </button>
                            <button id="backupDriveBtn" class="bg-green-900/50 hover:bg-green-800 border border-green-500 text-green-200 px-3 py-1.5 rounded text-sm transition-colors flex items-center shadow-md">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                Backup to Drive
                            </button>
                            <span id="recordCount" class="text-sm bg-gray-800 px-3 py-1 rounded-full border border-gray-700">0 Records</span>
                        </div>
                    </div>

                    <!-- Table Wrapper -->
                    <div id="tableContainer" class="hidden flex-1 overflow-x-auto custom-scrollbar rounded-lg border border-gray-800">
                        <table class="min-w-full divide-y divide-gray-800 text-sm">
                            <thead class="bg-[#1a1a1a]">
                                <tr>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Date</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Patient Name</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Age</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Contact</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Diagnosis</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Cost</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Paid</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Status</th>
                                    <th scope="col" class="px-4 py-3 text-left font-medium tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="patientTableBody" class="divide-y divide-gray-800 bg-[#0a0a0a]">
                                <!-- Rows populated by JS -->
                            </tbody>
                        </table>
                        
                        <!-- Empty State -->
                        <div id="emptyState" class="hidden p-8 text-center text-gray-500">
                            <svg class="mx-auto h-12 w-12 text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <p>No patient records found.</p>
                            <p class="text-sm mt-1">Add a new record to see it here.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- End of Data Management Section -->
    </div>

    <!-- Modal for viewing full prescription -->
    <div id="viewModal" class="fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 hidden opacity-0 transition-opacity duration-300 p-4">
        <div class="bg-[#111] border border-[#DAA520] rounded-xl p-6 max-w-lg w-full transform scale-95 transition-transform duration-300" id="viewModalContent">
            <div class="flex justify-between items-start mb-4 border-b border-[#DAA520] pb-3">
                <h3 class="text-xl font-bold text-[#FFD700]" id="modalTitle">Patient Details</h3>
                <button id="closeModalBtn" class="text-gray-400 hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="space-y-3 text-gray-300">
                <div>
                    <strong class="text-[#DAA520] block mb-1">Diagnosis:</strong> 
                    <div id="modalDiagnosis" class="bg-[#1a1a1a] p-3 rounded border border-gray-800"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <p><strong class="text-[#DAA520]">Total Cost:</strong> <span id="modalCost"></span></p>
                    <p><strong class="text-[#DAA520]">Paid:</strong> <span id="modalPaid"></span></p>
                    <p><strong class="text-[#DAA520]">Method:</strong> <span id="modalMethod"></span></p>
                    <p><strong class="text-[#DAA520]">Status:</strong> <span id="modalStatus"></span></p>
                    <p class="col-span-2"><strong class="text-[#DAA520]">Balance Due:</strong> <span id="modalBalance" class="text-red-400 font-bold"></span></p>
                </div>
                <div>
                    <strong class="text-[#DAA520] block mb-1">Prescription / Medications:</strong>
                    <div id="modalMeds" class="bg-[#1a1a1a] p-3 rounded border border-gray-800"></div>
                </div>
            </div>
            <div class="mt-6 flex justify-end">
                <button id="closeModalBottomBtn" class="bg-gray-800 hover:bg-gray-700 text-white px-4 py-2 rounded transition-colors border border-gray-600">Close</button>
            </div>
        </div>
    </div>

    <!-- MAIN APPLICATION SCRIPT - LOCAL STORAGE VERSION -->
    <script>
        // --- GOOGLE DRIVE API CONFIGURATION ---
        const CLIENT_ID = 'YOUR_CLIENT_ID_HERE';
