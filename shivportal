            const diagItems = patient.diagnosis.split(',').filter(d => d.trim()).map(d => `<li>${escapeHTML(d.trim())}</li>`).join('');
            const medItems = patient.medications.split('\n').filter(m => m.trim()).map(m => `<li>${escapeHTML(m.trim())}</li>`).join('');

            document.getElementById('modalTitle').textContent = `${patient.name} (${patient.age} yrs) - ${patient.date}`;
            document.getElementById('modalDiagnosis').innerHTML = `<ul class="list-disc pl-5">${diagItems || '<li>None</li>'}</ul>`;
