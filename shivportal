            document.getElementById('modalMethod').textContent = patient.paymentMethod || 'N/A';
            document.getElementById('modalStatus').textContent = patient.paymentStatus || 'N/A';
            document.getElementById('modalBalance').textContent = `₹${balance.toFixed(2)}`;
