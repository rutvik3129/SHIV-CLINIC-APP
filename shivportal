                } catch (e) {
                    console.error("Failed to parse local patient data");
                    encryptedRecords = [];
                }
            }

            patientRecords = encryptedRecords.map(data => ({
                id: data.id,
                name: decryptData(data.name),
                age: decryptData(data.age),
                date: data.date, 
                contact: decryptData(data.contact),
                cost: parseFloat(decryptData(data.cost)) || 0,
                amountPaid: parseFloat(decryptData(data.amountPaid)) || 0,
                paymentMethod: decryptData(data.paymentMethod),
                paymentStatus: decryptData(data.paymentStatus),
                diagnosis: decryptData(data.diagnosis),
                medications: decryptData(data.medications),
                createdAt: data.createdAt
            }));

            // Sort in memory by date (newest first)
            patientRecords.sort((a, b) => new Date(b.date) - new Date(a.date));
            renderTable();
        }

