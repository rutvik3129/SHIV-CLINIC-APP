        backupDriveBtn.addEventListener('click', () => {
            // Backup the encrypted raw data directly from local storage
            const rawData = localStorage.getItem(DB_KEY_PATIENTS);
            if (!rawData || rawData === '[]') {
                showToast("No patient records to backup.", true);
